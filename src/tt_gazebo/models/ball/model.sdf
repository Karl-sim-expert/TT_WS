<?xml version="1.0"?>
<sdf version="1.8">
  <model name="ball">
    <pose>0 0 1.0 0 0 0</pose>
    <!-- Publishes ground truth pose + velocity on /model/ball/odometry (gz.msgs.Odometry). -->
    <plugin filename="ignition-gazebo-odometry-publisher-system"
            name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>ball</robot_base_frame>
      <odom_publish_frequency>200</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
    <!-- Drag + Magnus + analytic table bounce; /ball/launch fires the ball (see BallPhysics.cc). -->
    <plugin filename="BallPhysics" name="tt_gazebo::BallPhysics">
      <drag_coefficient>0.40</drag_coefficient>
      <lift_slope>1.0</lift_slope>
      <lift_max>0.6</lift_max>
      <restitution>0.9</restitution>
      <friction>0.25</friction>
      <debug>true</debug>
      <!-- Parked (held motionless, no gravity) at the launch point until /ball/launch, /ball/hold
           or a paddle hit. Paddle: disc 150 mm x 12 mm, rubber restitution/friction. -->
      <park>true</park>
      <robot_name>tt_robot</robot_name>
      <paddle_radius>0.075</paddle_radius>
      <paddle_half_thickness>0.006</paddle_half_thickness>
      <paddle_restitution>0.85</paddle_restitution>
      <paddle_friction>0.45</paddle_friction>
      <launch_x>-1.8</launch_x>
      <launch_y>0.0</launch_y>
      <launch_z>1.0</launch_z>
    </plugin>
    <link name="link">
      <inertial>
        <mass>0.0027</mass>
        <!-- hollow sphere: 2/3 m r^2 -->
        <inertia>
          <ixx>7.2e-7</ixx><iyy>7.2e-7</iyy><izz>7.2e-7</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.02</radius></sphere></geometry>
        <surface>
          <friction><ode><mu>0.25</mu><mu2>0.25</mu2></ode></friction>
          <bounce><restitution_coefficient>0.9</restitution_coefficient><threshold>0.01</threshold></bounce>
        </surface>
      </collision>
      <visual name="visual">
        <geometry><sphere><radius>0.02</radius></sphere></geometry>
        <material>
          <ambient>1 0.5 0 1</ambient>
          <diffuse>1 0.5 0 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
