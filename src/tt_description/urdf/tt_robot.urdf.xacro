<?xml version="1.0"?>
<!-- Panda arm + paddle, ros2_control (gz_ros2_control, Gazebo Fortress). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tt_robot">
  <xacro:arg name="base_x" default="1.7"/>
  <xacro:arg name="base_y" default="0.0"/>
  <!-- base_z: arm base height on a pedestal next to the table end (0.6 m = 16 cm below the table top,
       which keeps both low balls and ~0.4 m-above-table balls inside the workspace). -->
  <xacro:arg name="base_z" default="0.6"/>
  <xacro:arg name="base_yaw" default="3.14159265359"/>
  <xacro:arg name="controllers" default="$(find tt_description)/config/controllers.yaml"/>

  <xacro:include filename="$(find tt_description)/urdf/panda_arm.urdf"/>

  <link name="world"/>

  <!-- Linear rail along world x (the stroke direction) carrying the arm. The rail supplies the
       fast translation of a stroke; the Panda arm mostly orients the paddle. rail_joint = 0 is
       the nominal base position (base_x); positive moves the base away from the table.
       Visual only (the ball never touches it); effort/velocity limits are sim values.
       rail_base: floor to base_z, so the arm works at table height. -->
  <xacro:arg name="rail_lower" default="-0.5"/>
  <xacro:arg name="rail_upper" default="0.6"/>
  <xacro:arg name="rail_velocity" default="4.0"/>
  <link name="rail_base">
    <visual>
      <origin xyz="${0.5 * ($(arg rail_upper) + $(arg rail_lower))} 0 ${0.5 * $(arg base_z) - 0.05}"/>
      <geometry><box size="${$(arg rail_upper) - $(arg rail_lower) + 0.5} 0.3 ${$(arg base_z) - 0.1}"/></geometry>
      <material name="rail_grey"><color rgba="0.35 0.35 0.35 1"/></material>
    </visual>
  </link>
  <joint name="world_to_rail" type="fixed">
    <parent link="world"/>
    <child link="rail_base"/>
    <origin xyz="$(arg base_x) $(arg base_y) 0" rpy="0 0 0"/>
  </joint>
  <link name="rail_carriage">
    <inertial>
      <origin xyz="0 0 ${$(arg base_z) - 0.05}"/>
      <mass value="5.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
    <visual>
      <origin xyz="0 0 ${$(arg base_z) - 0.05}"/>
      <geometry><box size="0.4 0.4 0.1"/></geometry>
      <material name="carriage_dark"><color rgba="0.15 0.15 0.15 1"/></material>
    </visual>
  </link>
  <joint name="rail_joint" type="prismatic">
    <parent link="rail_base"/>
    <child link="rail_carriage"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="$(arg rail_lower)" upper="$(arg rail_upper)" effort="5000" velocity="$(arg rail_velocity)"/>
    <dynamics damping="10"/>
  </joint>
  <joint name="carriage_to_base" type="fixed">
    <parent link="rail_carriage"/>
    <child link="panda_link0"/>
    <origin xyz="0 0 $(arg base_z)" rpy="0 0 $(arg base_yaw)"/>
  </joint>

  <!-- Paddle: disc of 150 mm diameter, 12 mm thick. Face normal = local +z (= panda_hand +x).
       No engine collision: the BallPhysics plugin computes the paddle impact analytically from
       this link's pose and velocity (a 10 m/s ball moves 1 cm per 1 ms step, the engine would
       miss thin contacts). The fixed joint is preserved so the link survives the URDF -> SDF
       conversion (otherwise it is lumped into panda_hand). -->
  <link name="paddle">
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="3.5e-4" ixy="0" ixz="0" iyy="3.5e-4" iyz="0" izz="4.2e-4"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.075" length="0.012"/></geometry>
      <material name="paddle_red"><color rgba="0.8 0.1 0.1 1"/></material>
    </visual>
  </link>
  <gazebo reference="paddle_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <joint name="paddle_joint" type="fixed">
    <parent link="panda_hand"/>
    <child link="paddle"/>
    <origin xyz="0 0 0.13" rpy="0 1.5707963 0"/>
  </joint>

  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <xacro:macro name="arm_joint" params="name initial">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <joint name="rail_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <!-- Ready pose: paddle ~0.5 m in front of the base, face vertical, normal toward the table. -->
    <xacro:arm_joint name="panda_joint1" initial="-0.058"/>
    <xacro:arm_joint name="panda_joint2" initial="0.132"/>
    <xacro:arm_joint name="panda_joint3" initial="0.351"/>
    <xacro:arm_joint name="panda_joint4" initial="-2.048"/>
    <xacro:arm_joint name="panda_joint5" initial="-0.631"/>
    <xacro:arm_joint name="panda_joint6" initial="1.803"/>
    <xacro:arm_joint name="panda_joint7" initial="1.559"/>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg controllers)</parameters>
    </plugin>
  </gazebo>
</robot>
